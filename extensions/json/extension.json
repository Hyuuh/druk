{
  "id": "json",
  "name": "JSON",
  "version": "1.2.0",
  "description": "JSON and JSONC highlighting and the VS Code JSON server. Also reads `bun.lock`.",
  "languages": [
    {
      "id": "json",
      "grammar": {
        "vendored": "json"
      }
    },
    {
      "id": "jsonc",
      "grammar": {
        "vendored": "json"
      },
      "extensions": [".jsonc"],
      "filenames": ["bun.lock"],
      "lineComment": "//"
    }
  ],
  "languageServers": [
    {
      "id": "json",
      "command": ["vscode-json-language-server", "--stdio"],
      "filetypes": ["json", "jsonc"],
      "settings": {
        "json": {
          "validate": { "enable": true },
          "schemas": [
            {
              "fileMatch": ["bun.lock"],
              "schema": { "allowTrailingCommas": true, "allowComments": true }
            }
          ]
        }
      },
      "install": {
        "kind": "npm",
        "packages": ["vscode-langservers-extracted"]
      }
    }
  ]
}
