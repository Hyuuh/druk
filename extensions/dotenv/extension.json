{
  "id": "dotenv",
  "name": "dotenv",
  "version": "1.0.0",
  "description": "`.env` files, whatever they are named.",
  "languages": [
    {
      "id": "dotenv",
      "label": "env",
      "lineComment": "#",
      "patterns": [
        {
          "group": "punctuation",
          "re": "=",
          "flags": "g"
        },
        {
          "group": "number",
          "re": "\\b\\d+(?:\\.\\d+)?\\b",
          "flags": "g"
        },
        {
          "group": "boolean",
          "re": "\\b(?:true|false|null)\\b",
          "flags": "gi"
        },
        {
          "group": "string",
          "re": "\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'",
          "flags": "g"
        },
        {
          "group": "variable",
          "re": "\\$\\{[\\w.]+\\}|\\$[A-Za-z_]\\w*",
          "flags": "g"
        },
        {
          "group": "property",
          "re": "^[ \\t]*(?:export[ \\t]+)?[\\w.]+(?=[ \\t]*=)",
          "flags": "gm"
        },
        {
          "group": "keyword",
          "re": "^[ \\t]*export\\b",
          "flags": "gm"
        },
        {
          "group": "comment",
          "re": "^[ \\t]*#.*",
          "flags": "gm"
        }
      ],
      "filenamePattern": "^\\.env(?:\\.[\\w.-]+)?$|\\.env$"
    }
  ]
}
